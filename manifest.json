{
  "manifest_version": 3,
  "name": "TimezoneBuddy",
  "version": "0.1.0",
  "description": "Quickly convert a time across your favorite timezones.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TimezoneBuddy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "browser_specific_settings": {
    "gecko": {
      "id": "timezonebuddy@thecollectedworks.com",
      "strict_min_version": "115.0"
    }
  }
}
